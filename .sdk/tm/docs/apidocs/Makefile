# Build and preview this documentation site.
#
# Generated by @voxgig/docgen. The site CONTENT is regenerated from the API
# model — run `npm run generate` in the SDK project, not by editing pages
# here, which are overwritten.

.PHONY: install serve build clean

install:
	pip install -r requirements.txt

serve: install
	mkdocs serve

build: install
	mkdocs build --strict

clean:
	rm -rf site
