{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "noEmitOnError": true,
    "outDir": "../dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "declaration": true,
    "declarationDir": "../dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "composite": true
  }
}
